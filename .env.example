# Copy to .env and fill in. Run /setup in Claude Code for a guided walkthrough.

# Cal.com API key (Settings > Developer > API Keys)
CAL_API_KEY=

# Retell API key (Retell dashboard > API Keys)
RETELL_API_KEY=

# Shared secret Retell sends to your server, generate with: openssl rand -hex 32
API_BEARER_TOKEN=

# Department -> Cal.com event type ID, first one is the default (single quotes needed here)
EVENT_TYPES='{"sales": 123456, "delivery": 654321}'

# IANA timezone your bookings are in
TIMEZONE=Australia/Melbourne

# Optional: phone used when the caller's number isn't available (Retell web test calls)
FALLBACK_PHONE=

# Your deployed server URL, e.g. https://your-app.onrender.com
RENDER_BASE_URL=

# Filled in after running setup/create_agent.py
AGENT_ID=
